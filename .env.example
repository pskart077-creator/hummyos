# ─── App ─────────────────────────────────────────────────────────────
NODE_ENV=development
APP_URL=http://localhost:3000
# Ambiente exibido no header: production | staging | development
APP_ENV=development

# ─── Database ────────────────────────────────────────────────────────
# Postgres (use o docker-compose incluso para subir local)
DATABASE_URL=postgresql://hummy:hummy@localhost:5432/hummy_os?schema=public

# ─── Auth / Crypto ───────────────────────────────────────────────────
# Segredo para assinar sessões/JWT. Gere com: openssl rand -base64 32
NEXTAUTH_SECRET=
# Chave de criptografia de secrets no banco (32 bytes em base64).
# Gere com: openssl rand -base64 32
ENCRYPTION_KEY=

# ─── Seed (apenas primeiro setup) ────────────────────────────────────
ADMIN_EMAIL=admin@hummy.local
ADMIN_PASSWORD=
ADMIN_NAME=Lucas

# ─── Redis / Filas (opcional no MVP) ─────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── OpenClaw ────────────────────────────────────────────────────────
OPENCLAW_BASE_URL=
OPENCLAW_AUTH_TOKEN=
OPENCLAW_DEFAULT_AGENT_ID=
OPENCLAW_GATEWAY_URL=http://localhost:18789
OPENCLAW_GATEWAY_TOKEN=
OPENCLAW_AGENT_ID=main

HUMMY_MCP_ORG_ID=
HUMMY_MCP_AGENT_ID=

SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://localhost:3000/api/integrations/spotify/callback
SPOTIFY_REFRESH_TOKEN=

# ─── Meta Ads ────────────────────────────────────────────────────────
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=http://localhost:3000/api/integrations/meta/callback
META_API_VERSION=v21.0
# Chave dedicada para criptografar tokens da Meta (32 bytes base64)
META_ENCRYPTION_SECRET=

# ─── Provedor de IA (chat / agentes) ─────────────────────────────────
# Opcional no MVP. Sem chave, o chat responde em modo "eco/local".
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# ElevenLabs (voz do Jarvis)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
